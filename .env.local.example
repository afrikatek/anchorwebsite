# Required: Resend API key — get one at https://resend.com
RESEND_API_KEY=

# Verified Resend sender (must be on a domain verified in Resend)
CONTACT_FROM=Anchor Risk Transfer <site@anchorrisktransfer.com>

# Recipient for contact form submissions
CONTACT_TO=underwriting@anchorrisktransfer.com

# Allowed origin(s) for /api/contact (comma-separate for multiple)
ALLOWED_ORIGIN=http://localhost:5173,https://anchorrisktransfer.com

# Cloudflare Turnstile — get keys at https://dash.cloudflare.com (Turnstile)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
